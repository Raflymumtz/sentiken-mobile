# URL backend yang diakses dari aplikasi mobile.
# Emulator Android: http://10.0.2.2:8000/api/v1
# Simulator iOS: http://localhost:8000/api/v1
# Device fisik (Expo Go, jaringan sama): http://<IP-LAN-komputer>:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Kredensial untuk auto-login diam-diam (aplikasi login otomatis di background,
# tanpa menampilkan layar login ke pengguna). Harus sama dengan ADMIN_EMAIL /
# ADMIN_PASSWORD di backend/.env.
EXPO_PUBLIC_AUTO_LOGIN_EMAIL=admin@sentiken.local
EXPO_PUBLIC_AUTO_LOGIN_PASSWORD=
