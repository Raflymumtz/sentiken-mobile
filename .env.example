# =============================================================================
# SENTIKEN Mobile - Environment Variables (contoh)
# Salin file ini menjadi ".env" pada root proyek dan sesuaikan nilainya.
# JANGAN commit file ".env" yang berisi rahasia asli ke version control.
# =============================================================================

# --- PostgreSQL (database utama) ---------------------------------------------
POSTGRES_USER=sentiken
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=sentiken
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Digunakan oleh backend (SQLAlchemy). Untuk menjalankan backend di host
# (di luar Docker) ganti "postgres" dengan "localhost".
DATABASE_URL=postgresql+psycopg2://sentiken:change_me_in_production@postgres:5432/sentiken

# --- Redis (background job / RQ) ---------------------------------------------
REDIS_URL=redis://redis:6379/0
# Mode eksekusi job: "inline" (tanpa Redis, thread lokal, cocok untuk dev/test)
# atau "rq" (menggunakan Redis + worker container, direkomendasikan produksi).
JOB_EXECUTION_MODE=rq

# --- Autentikasi admin (JANGAN hard-code, hanya lewat environment) ----------
ADMIN_EMAIL=admin@sentiken.local
ADMIN_PASSWORD=change_me_admin_password
ADMIN_FULL_NAME=Administrator SENTIKEN

# --- JWT ----------------------------------------------------------------------
JWT_SECRET_KEY=change_me_to_a_long_random_secret_value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ----------------------------------------------------------------------
# Daftar origin yang diizinkan, dipisahkan koma. Gunakan "*" hanya saat development.
CORS_ALLOWED_ORIGINS=*
ENVIRONMENT=development

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
SCRAPE_REQUEST_DELAY_SECONDS=1.5
SCRAPE_MAX_RETRIES=3

# --- Upload / import CSV --------------------------------------------------------
MAX_CSV_UPLOAD_SIZE_MB=15

# --- Model storage ---------------------------------------------------------------
ML_MODEL_STORAGE_DIR=/app/storage/models
EXPORT_STORAGE_DIR=/app/storage/exports

# --- App sources (opsional, dapat juga diatur lewat mobile app) ----------------
# Package ID awal untuk seed app_sources. Boleh dikosongkan lalu diisi lewat app.
PLN_MOBILE_PACKAGE_ID=
MYPERTAMINA_PACKAGE_ID=

# --- pgAdmin (opsional, profile "tools") ----------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@sentiken.local
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin

# --- Mobile (Expo) ----------------------------------------------------------------
# URL backend yang diakses dari mobile app (Expo Go / emulator / device fisik).
# Contoh emulator Android: http://10.0.2.2:8000/api/v1
# Contoh device fisik di jaringan yang sama: http://<ip-lan-komputer>:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
